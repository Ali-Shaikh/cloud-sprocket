{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the CloudSprocket desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/cloudsprocketd",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/cloudsprocketd",
          "sidecar": true
        }
      ]
    },
    "dialog:allow-open",
    "shell:allow-kill",
    "shell:allow-stdin-write"
  ]
}

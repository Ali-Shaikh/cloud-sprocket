{
  "name": "@cloudsprocket/desktop",
  "version": "0.9.13",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "build": "node ./scripts/vite-build.mjs",
    "generate:notices": "node ./scripts/generate-third-party-notices.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "build:sidecar": "node ./scripts/prepare-sidecar.mjs",
    "verify:windows-subsystem": "node ./scripts/verify-windows-subsystem.mjs",
    "dev:desktop": "pnpm run build:sidecar && tauri dev",
    "dev:desktop:local": "pnpm run build:sidecar && tauri dev --config src-tauri/tauri.local.conf.json",
    "build:desktop:exe": "pnpm run build && pnpm run build:sidecar && tauri build --no-bundle && pnpm run verify:windows-subsystem",
    "build:desktop:local": "pnpm run build && pnpm run build:sidecar && tauri build --config src-tauri/tauri.local.conf.json --no-bundle",
    "build:desktop": "pnpm run build && pnpm run build:sidecar && tauri build && pnpm run verify:windows-subsystem",
    "bundle:macos:local:app": "pnpm run build && pnpm run build:sidecar && tauri build --config src-tauri/tauri.local.conf.json --bundles app --no-sign",
    "bundle:macos:local:dmg": "pnpm run build && pnpm run build:sidecar && tauri build --config src-tauri/tauri.local.conf.json --bundles dmg --no-sign",
    "bundle:macos:release:dmg": "pnpm run build && pnpm run build:sidecar && tauri build --bundles dmg",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.4",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "5.2.3",
    "lucide-react": "^1.28.0",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.6"
  }
}

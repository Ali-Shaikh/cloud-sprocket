{
  "name": "cloud-sprocket-workspace",
  "version": "0.9.10",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "dev:desktop": "pnpm --dir apps/desktop dev:desktop",
    "dev:desktop:local": "pnpm --dir apps/desktop dev:desktop:local",
    "build": "pnpm --dir apps/desktop build",
    "generate:notices": "pnpm --dir apps/desktop generate:notices",
    "build:desktop:exe": "pnpm --dir apps/desktop build:desktop:exe",
    "build:desktop": "pnpm --dir apps/desktop build:desktop",
    "build:desktop:local": "pnpm --dir apps/desktop build:desktop:local",
    "bundle:macos:local:app": "pnpm --dir apps/desktop bundle:macos:local:app",
    "bundle:macos:local:dmg": "pnpm --dir apps/desktop bundle:macos:local:dmg",
    "bundle:macos:release:dmg": "pnpm --dir apps/desktop bundle:macos:release:dmg",
    "test": "pnpm run test:desktop && pnpm run test:backend",
    "test:desktop": "pnpm --dir apps/desktop test",
    "test:desktop:coverage": "pnpm --dir apps/desktop test:coverage",
    "typecheck:desktop": "pnpm --dir apps/desktop run typecheck",
    "test:backend": "go -C backend/daemon test ./...",
    "test:backend:coverage": "go -C backend/daemon test -coverprofile coverage.out ./...",
    "test:backend:race": "go -C backend/daemon test -race ./internal/app/...",
    "prepare:sidecar": "pnpm --dir apps/desktop build:sidecar",
    "lint:desktop": "pnpm --dir apps/desktop lint",
    "lint:backend": "node ./scripts/run-golangci.mjs",
    "lint": "pnpm run lint:desktop && pnpm run lint:backend"
  }
}
